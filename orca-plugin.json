{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "sandboxed-ui",
  "id": "media-viewer",
  "name": "Media Viewer",
  "version": "0.1.0",
  "description": "Video and audio in Orca's editor tabs: plays .mkv, .mka and .weba, which Orca cannot show, and adds a full player view to .mp4, .mov, .webm, .mp3, .flac and other media. Speed, frame stepping, repeat, frame snapshots, file info and keyboard shortcuts.",
  "author": { "name": "Sergei Popov", "url": "https://github.com/Sergei-Popov" },
  "repository": "https://github.com/Sergei-Popov/orca-media-viewer",
  "license": "MIT",
  "engines": { "orca": ">=1.4.248" },
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "media",
        "title": "Media Player",
        "extensions": [".mkv", ".mka", ".weba"],
        "entry": "src/editor.ts",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "media-plus",
        "title": "Media Player",
        "extensions": [".mp4", ".m4v", ".mov", ".webm", ".mp3", ".wav", ".m4a", ".aac", ".ogg", ".oga", ".flac", ".opus"],
        "entry": "src/editor.ts",
        "priority": "option",
        "contentKind": "bytes",
        "frame": "isolated"
      }
    ]
  },
  "capabilities": []
}
